{
  "name": "tignal",
  "version": "0.1.0",
  "private": true,
  "description": "TİGNAL - Cep telefonu aksesuarları için bayi/stok/cari/fatura/CRM yönetim uygulaması",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @tignal/shared build && pnpm --filter @tignal/db build && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @tignal/db generate",
    "db:migrate": "pnpm --filter @tignal/db migrate",
    "db:migrate:deploy": "pnpm --filter @tignal/db migrate:deploy",
    "db:seed": "pnpm --filter @tignal/db seed",
    "db:studio": "pnpm --filter @tignal/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "bcrypt"
    ]
  }
}
