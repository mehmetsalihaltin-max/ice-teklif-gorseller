# ---- Veritabanı (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/tignal?schema=public"

# ---- API ----
API_PORT=3001
# JWT gizli anahtarları (üretimde mutlaka güçlü ve gizli değerlerle değiştirin)
JWT_ACCESS_SECRET="degistirin-access-secret"
JWT_REFRESH_SECRET="degistirin-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Web uygulamasının origin'i (CORS için)
WEB_ORIGIN="http://localhost:3000"

# ---- e-Fatura sağlayıcısı ----
# MOCK | NILVERA | ... (şimdilik MOCK)
E_INVOICE_PROVIDER="MOCK"

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Seed (ilk admin kullanıcı) ----
SEED_ADMIN_EMAIL="admin@tignal.local"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_COMPANY_NAME="TİGNAL A.Ş."
